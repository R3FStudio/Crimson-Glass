[Desktop Entry]
Name=Proton (GE, SDR)
Comment=Run a Windows game through Proton in SDR
Type=Application
Exec="@HOME@/.local/bin/windows-app-loader" proton-sdr %f
Icon=steam
NoDisplay=true
Terminal=false
MimeType=application/x-local-windows-program;application/x-ms-dos-executable;application/x-msdownload;application/vnd.microsoft.portable-executable;
