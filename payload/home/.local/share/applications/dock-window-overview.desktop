[Desktop Entry]
Type=Application
Name=Window Overview
Comment=Show all open windows
Icon=@HOME@/.local/share/icons/hicolor/scalable/apps/dock-window-overview.svg
Exec=/usr/bin/gdbus call --session --dest org.gnome.Shell --object-path /org/gnome/Shell --method org.freedesktop.DBus.Properties.Set org.gnome.Shell OverviewActive <true>
Terminal=false
Categories=Utility;
