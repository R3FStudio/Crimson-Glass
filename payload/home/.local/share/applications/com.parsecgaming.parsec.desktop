[Desktop Entry]
Type=Application
Name=Parsec
GenericName=Parsec
Icon=com.parsecgaming.parsec
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=/app/bin/parsec --file-forwarding com.parsecgaming.parsec @@u %u @@
